local function addWheel(carFolder,x,z)
    cylinder(carFolder,"Wheel",Vector3.new(1.25,4.6,4.6),cf(x,2.1,z),Color3.fromRGB(36,36,36),Enum.Material.Metal)
    cylinder(carFolder,"Hub",Vector3.new(1.4,1.8,1.8),cf(x,2.1,z),C.steel2,Enum.Material.Metal,false)
end

local function addSpeaker(parent,x,y,z)
    part(parent,"Speaker",Vector3.new(4.2,7.4,3.2),cf(x,y,z),C.black,Enum.Material.Metal)
    for _,dy in ipairs({-1.7,1.6}) do
        cylinder(parent,"Driver",Vector3.new(0.35,2.7,2.7),cf(x,y+dy,z-1.72,0,90,0),Color3.fromRGB(25,25,25),Enum.Material.SmoothPlastic,false)
    end
end

local function addCar(index, centerZ, role)
    local f=Instance.new("Folder")
    f.Name=string.format("CAR_%02d_%s",index,role)
    f.Parent=train
    local centerX=22
    local L=50
    part(f,"Underframe",Vector3.new(16.8,1.1,L-1),cf(centerX,3.35,centerZ),C.black,Enum.Material.Metal)
    part(f,"Floor",Vector3.new(16.2,0.7,L-2),cf(centerX,4.35,centerZ),Color3.fromRGB(49,47,44),Enum.Material.DiamondPlate)
    for _,sx in ipairs({-1,1}) do
        local x=centerX+sx*8.15
        part(f,"LowerBody",Vector3.new(0.75,4.6,L-2),cf(x,6.8,centerZ),index>=3 and C.charcoal or C.steel,Enum.Material.CorrodedMetal)
        part(f,"UpperRail",Vector3.new(0.7,2.2,L-2),cf(x,14.1,centerZ),C.charcoal,Enum.Material.Metal)
        part(f,"WindowSill",Vector3.new(0.55,0.55,L-2),cf(x-sx*0.15,9.1,centerZ),C.steel2,Enum.Material.Metal)
        part(f,"WindowTop",Vector3.new(0.55,0.55,L-2),cf(x-sx*0.15,13.0,centerZ),C.steel2,Enum.Material.Metal)
        for dz=-19,19,6.5 do
            local isDoor = (sx==-1 and math.abs(dz+0.5)<3.5)
            if not isDoor then
                part(f,"WindowGlass",Vector3.new(0.24,3.35,5.3),cf(x-sx*0.39,11.05,centerZ+dz),C.glass,Enum.Material.Glass,0.42,false)
                part(f,"Mullion",Vector3.new(0.34,3.8,0.22),cf(x-sx*0.42,11.05,centerZ+dz+2.8),C.black,Enum.Material.Metal)
            else
                part(f,"DoorFrameA",Vector3.new(0.6,8.3,0.5),cf(x,9.2,centerZ+dz-3),C.steel2,Enum.Material.Metal)
                part(f,"DoorFrameB",Vector3.new(0.6,8.3,0.5),cf(x,9.2,centerZ+dz+3),C.steel2,Enum.Material.Metal)
                part(f,"DoorHeader",Vector3.new(0.6,0.55,6.5),cf(x,13.3,centerZ+dz),C.steel2,Enum.Material.Metal)
                part(f,"Step",Vector3.new(2.4,0.45,6.2),cf(x-2.1,3.5,centerZ+dz),C.steel2,Enum.Material.DiamondPlate)
            end
        end
    end
    for _,sz in ipairs({-1,1}) do
        local z=centerZ+sz*24.5
        part(f,"EndSideL",Vector3.new(5.8,10.7,0.65),cf(centerX-5.2,9.3,z),C.steel,Enum.Material.CorrodedMetal)
        part(f,"EndSideR",Vector3.new(5.8,10.7,0.65),cf(centerX+5.2,9.3,z),C.steel,Enum.Material.CorrodedMetal)
        part(f,"EndTop",Vector3.new(4.8,2.2,0.7),cf(centerX,13.6,z),C.charcoal,Enum.Material.Metal)
    end
    local roofBands={{-6.3,15.2,-30},{-3.3,16.55,-14},{0,17.0,0},{3.3,16.55,14},{6.3,15.2,30}}
    for _,b in ipairs(roofBands) do
        part(f,"RoofBand",Vector3.new(4.0,0.65,L),cf(centerX+b[1],b[2],centerZ,0,0,b[3]),Color3.fromRGB(64,66,65),Enum.Material.CorrodedMetal)
    end
    for dz=-16,16,16 do
        cylinder(f,"RoofVent",Vector3.new(1.0,2.2,2.2),cf(centerX,17.55,centerZ+dz,0,0,90),Color3.fromRGB(52,54,53),Enum.Material.Metal,false)
    end
    part(f,"RoofConduit",Vector3.new(0.5,0.5,L-8),cf(centerX+2.2,17.45,centerZ),C.steel2,Enum.Material.Metal,0,false)
    for _,dz in ipairs({-15.5,15.5}) do
        part(f,"Bogie",Vector3.new(14,1.1,8.5),cf(centerX,2.8,centerZ+dz),C.black,Enum.Material.Metal)
        for _,sx in ipairs({-1,1}) do
            addWheel(f,centerX+sx*6.6,centerZ+dz-2.2)
            addWheel(f,centerX+sx*6.6,centerZ+dz+2.2)
        end
    end
    for _,sz in ipairs({-1,1}) do
        part(f,"CouplerBeam",Vector3.new(1.3,1.1,4.0),cf(centerX,3.2,centerZ+sz*26.5),C.black,Enum.Material.Metal)
        cylinder(f,"CouplerHead",Vector3.new(0.9,2.4,2.4),cf(centerX,3.2,centerZ+sz*28.1,0,90,0),C.steel,Enum.Material.Metal,false)
    end
    for _,sx in ipairs({-1,1}) do
        part(f,"Stripe",Vector3.new(0.18,0.72,L-3),cf(centerX+sx*8.56,8.6,centerZ),index>=3 and C.signalRed or C.rust2,Enum.Material.Metal,0,false)
    end
    for dz=-18,18,9 do
        local col = index>=3 and (index==4 and C.signalRed or C.amber) or C.warm
        local fixture=part(f,"CeilingLamp",Vector3.new(1.2,0.22,2.2),cf(centerX,15.55,centerZ+dz),col,Enum.Material.Neon,0,false)
        local l=addPointLight(fixture,col,index>=3 and 1.2 or 0.7,index>=3 and 14 or 10)
        if index>=3 then l.Name="PulseLight"; fixture.Parent=lightsFolder end
    end
    local plate=part(f,"CarPlate",Vector3.new(5.5,2.0,0.35),cf(centerX-8.62,8.1,centerZ-18,0,90,0),C.black,Enum.Material.Metal)
    surfaceText(plate,Enum.NormalId.Front,string.format("CAR %02d",index),C.white,C.black)
    return f
end

local car1=addCar(1,-58,"SOCIAL")
local car2=addCar(2,-5,"BAR")

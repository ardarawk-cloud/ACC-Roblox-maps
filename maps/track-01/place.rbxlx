-- Railway signal.
cylinder(props,"SignalMast",Vector3.new(13,0.7,0.7),cf(34,7.5,145,0,0,90),C.black,Enum.Material.Metal)
part(props,"SignalHead",Vector3.new(3.2,8,2.4),cf(34,14.2,145),C.black,Enum.Material.Metal)

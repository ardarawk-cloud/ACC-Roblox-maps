root.Name = ROOT_NAME
root.Parent = Workspace
root:SetAttribute("Version", VERSION)
root:SetAttribute("UniverseId", "10745349805")
root:SetAttribute("PlaceId", "79748872921213")
root:SetAttribute("Concept", "Abandoned Railway Station Nightclub")


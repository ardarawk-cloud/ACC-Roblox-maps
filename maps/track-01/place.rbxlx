surfaceText(menu,Enum.NormalId.Left,"DEPARTURES\nJAKARTA  22:30\nTOKYO  23:00\nBERLIN  23:45\nIBIZA  00:30\nUNKNOWN  01:00",C.amber,C.black,Enum.Font.RobotoMono)

-- CAR 03 dance room.
for _,z in ipairs({36,48,60}) do

neonTube(car4,"HeroRedL",Vector3.new(0.25,6.5,0.25),cf(16.2,11.4,123.65),C.signalRed,1.4)
neonTube(car4,"HeroRedR",Vector3.new(0.25,6.5,0.25),cf(27.8,11.4,123.65),C.signalRed,1.4)
for z=82,109,9 do
    local beamFixture=part(car4,"SpotFixture",Vector3.new(1.1,0.8,1.1),cf(22,15.0,z),C.black,Enum.Material.Metal,0,false)
    local spot=addSpot(beamFixture,(z%18==0) and C.signalRed or C.amber,1.8,25,55,Enum.NormalId.Bottom)
    spot.Name="PulseLight"
    beamFixture.Parent=lightsFolder
end

-- THE YARD outdoor area.
part(architecture,"YardPad",Vector3.new(70,0.6,96),cf(-43,0.3,65),Color3.fromRGB(47,47,44),Enum.Material.Asphalt)
part(architecture,"YardWall",Vector3.new(2,9,96),cf(-78,4.5,65),C.brickDark,Enum.Material.Brick)

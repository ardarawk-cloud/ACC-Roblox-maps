end

-- Invisible safety boundaries.
for _,spec in ipairs({
    {Vector3.new(290,30,2),cf(4,14,-194)},
    {Vector3.new(290,30,2),cf(4,14,234)},
    {Vector3.new(2,30,430),cf(-141,14,20)},
